# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Default MySQL 8.4 on Port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=mcc_chronicles

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Client Application URL (CORS origin)
CLIENT_URL=http://localhost:5173
